{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sadhyastore",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "STORE_API_ORIGIN": "https://sadhya-api.onrender.com"
  },
  "observability": {
    "enabled": true,
  },
}
